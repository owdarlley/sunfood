<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a abertura do sistema mostra só o fundo areia, sem o ícone grande. -->
    <style name="LauncherTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/navigationColor</item>
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash</item>
    </style>
</resources>
