{
  "regions": ["pdx1"],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && [ \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .",
  "crons": [{ "path": "/cron/limpeza", "schedule": "0 9 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
